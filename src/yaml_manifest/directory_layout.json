{
    "assembly_stats": "results/assembly_stats",
    "config": "config",
    "downloads": "resources/raw_reads/{data_type}",
    "git_logs": "results/git_logs",
    "logs": "logs/{stage}",
    "pipeline_output": "results/{pipeline}/{dataset_id}.{assembly_version}",
    "profiles": "profiles",
    "qc_reads": "results/qc/reads/{data_type}",
    "qc_stats": "results/qc/stats/{data_type}",
    "receipts": "results/upload_receipts",
    "resources": "resources",
    "results": "results",
    "scripts": "scripts",
    "status_updates": "results/update_assembly_status",
    "stages": {
        "raw": {
            "dir": "downloads",
            "logs": "logs/download",
            "outputs": {
                "paired_end": {
                    "r1": "{name}.r1.{ext}",
                    "r2": "{name}.r2.{ext}"
                },
                "single_end": {
                    "single_end": "{name}.{ext}"
                }
            }
        },
        "qc": {
            "dir": "qc_reads",
            "logs": "logs/qc",
            "outputs": {
                "paired_end": {
                    "reads": "{name}.{ext}"
                },
                "single_end": {
                    "reads": "{name}.{ext}"
                }
            },
            "ext": {
                "Hi-C": "cram",
                "OXFORD_NANOPORE": "fastq.gz",
                "PACBIO_SMRT": "fastq.gz"
            },
            "stats": {
                "dir": "qc_stats",
                "pattern": "{name}.json"
            }
        },
        "genomeassembly": {
            "dir": "pipeline_output",
            "logs": "logs/genomeassembly",
            "pipeline_input": {
                "genomic_data": "config/genomeassembly.data.yaml",
                "assembly_specs": "config/genomeassembly.spec.yaml"
            },
            "pipeline_runscript": "scripts/genomeassembly.sh",
            "upload": {
                "exclude_patterns": [
                    "*.bam",
                    "*.bin",
                    "*.ktab.*"
                ],
                "compress_extensions": [
                    ".bed",
                    ".fa",
                    ".fasta",
                    ".paf"
                ]
            }
        },
        "ascc": {
            "dir": "pipeline_output",
            "logs": "logs/ascc",
            "pipeline_input": {
                "input": "config/ascc.yaml",
                "samplesheet": "config/ascc_samplesheet.csv"
            },
            "pipeline_runscript": "scripts/ascc.sh",
            "upload": {
                "exclude_patterns": [],
                "compress_extensions": [
                    ".fasta"
                ]
            }
        },
        "curation": {
            "dir": "pipeline_output",
            "logs": "logs/curation",
            "pipeline_input": {
                "agp": "curation/curated.agp_1",
                "exclude": "curation/exclude.txt"
            },
            "upload": {
                "exclude_patterns": [],
                "compress_extensions": [
                    ".agp",
                    ".csv",
                    ".fa",
                    ".fasta",
                    ".log"
                ]
            }
        },
        "curationpretext": {
            "dir": "pipeline_output",
            "logs": "logs/curationpretext",
            "pipeline_input": {
                "input": "config/curationpretext.yaml"
            },
            "pipeline_runscript": "scripts/curationpretext.sh",
            "upload": {
                "exclude_patterns": [],
                "compress_extensions": []
            }
        },
        "treeval": {
            "dir": "pipeline_output",
            "logs": "logs/treeval",
            "pipeline_input": {
                "input": "config/treeval.yaml"
            },
            "pipeline_runscript": "scripts/treeval.sh",
            "upload": {
                "exclude_patterns": [
                    "*.ktab.*"
                ],
                "compress_extensions": [
                    ".bed"
                ]
            }
        },
        "submission_assemblies": {
            "dir": "submission/assemblies",
            "logs": "logs/submission",
            "pipeline_input": {
                "chromosome_list": "submission/chromosome_list.txt"
            },
            "upload": {
                "exclude_patterns": [],
                "compress_extensions": [
                    ".json",
                    ".report",
                    ".xml"
                ]
            }
        },
        "submission_reads": {
            "dir": "submission/reads",
            "logs": "logs/submission",
            "pipeline_input": {},
            "upload": {
                "exclude_patterns": [],
                "compress_extensions": [
                    ".json",
                    ".report",
                    ".xml"
                ]
            }
        }
    }
}