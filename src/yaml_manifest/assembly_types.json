{
    "pacbio_hifi.purged": {
        "long_read_platform": "pacbio_hifi",
        "requires_hic": false,
        "assembler": "hifiasm",
        "outputs": {
            "genomeassembly": {
                "PRIMARY": "{dataset_id}.{assembly_version}.pacbio_hifi.purged/purging/asm.purged.fa.gz",
                "HAPLO": "{dataset_id}.{assembly_version}.pacbio_hifi.purged/purging/asm.htigs.all.fa.gz"
            },
            "ascc": {
                "PRIMARY": "{dataset_id}.{assembly_version}_PRIMARY/autofilter/{dataset_id}.{assembly_version}_PRIMARY_autofiltered.fasta",
                "HAPLO": "{dataset_id}.{assembly_version}_HAPLO/autofilter/{dataset_id}.{assembly_version}_HAPLO_autofiltered.fasta"
            }
        }
    },
    "oxford_nanopore.purged": {
        "long_read_platform": "oxford_nanopore",
        "requires_hic": false,
        "assembler": "hifiasm",
        "outputs": {
            "genomeassembly": {
                "PRIMARY": "{dataset_id}.{assembly_version}.oxford_nanopore.purged/purging/asm.purged.fa.gz",
                "HAPLO": "{dataset_id}.{assembly_version}.oxford_nanopore.purged/purging/asm.htigs.all.fa.gz"
            },
            "ascc": {
                "PRIMARY": "{dataset_id}.{assembly_version}_PRIMARY/autofilter/{dataset_id}.{assembly_version}_PRIMARY_autofiltered.fasta",
                "HAPLO": "{dataset_id}.{assembly_version}_HAPLO/autofilter/{dataset_id}.{assembly_version}_HAPLO_autofiltered.fasta"
            }
        }
    },
    "pacbio_hifi.phased": {
        "long_read_platform": "pacbio_hifi",
        "requires_hic": true,
        "assembler": "hifiasm",
        "outputs": {
            "genomeassembly": {
                "PRIMARY": "{dataset_id}.{assembly_version}.pacbio_hifi.phased/scaffolding/asm_hap1_scaffolds_final.fa.gz",
                "HAPLO": "{dataset_id}.{assembly_version}.pacbio_hifi.phased/scaffolding/asm_hap2_scaffolds_final.fa.gz",
                "PRIMARY_BUSCO_TABLE": "{dataset_id}.{assembly_version}.pacbio_hifi.phased/scaffolding/busco.{busco_odb12_dataset_name}_odb12/asm-busco/asm_hap1_scaffolds_final.fa/run_{busco_odb12_dataset_name}_odb12/full_table.tsv",
                "HAPLO_BUSCO_TABLE": "{dataset_id}.{assembly_version}.pacbio_hifi.phased/scaffolding/busco.{busco_odb12_dataset_name}_odb12/asm-busco/asm_hap2_scaffolds_final.fa/run_{busco_odb12_dataset_name}_odb12/full_table.tsv"
            },
            "ascc": {
                "PRIMARY": "{dataset_id}.{assembly_version}_PRIMARY/autofilter/{dataset_id}.{assembly_version}_PRIMARY_autofiltered.fasta",
                "HAPLO": "{dataset_id}.{assembly_version}_HAPLO/autofilter/{dataset_id}.{assembly_version}_HAPLO_autofiltered.fasta",
                "PRIMARY_ABNORMAL_CHECK": "{dataset_id}.{assembly_version}_PRIMARY/autofilter/{dataset_id}.{assembly_version}_PRIMARY_ABNORMAL_CHECK.csv",
                "PRIMARY_CHECK_SUMMARY": "{dataset_id}.{assembly_version}_PRIMARY/ascc_main_output/{dataset_id}.{assembly_version}_PRIMARY_contamination_check_merged_table.csv",
                "PRIMARY_REMOVED_SEQUENCES": "{dataset_id}.{assembly_version}_PRIMARY/autofilter/assembly_filtering_removed_sequences.txt",
                "PRIMARY_MT_CONTIGS": "{dataset_id}.{assembly_version}_PRIMARY/organelle_contamination_recommendations/{dataset_id}.{assembly_version}_PRIMARY-{dataset_id}.{assembly_version}_MITO.contamination_recommendation",
                "HAPLO_ABNORMAL_CHECK": "{dataset_id}.{assembly_version}_HAPLO/autofilter/{dataset_id}.{assembly_version}_HAPLO_ABNORMAL_CHECK.csv",
                "HAPLO_CHECK_SUMMARY": "{dataset_id}.{assembly_version}_HAPLO/ascc_main_output/{dataset_id}.{assembly_version}_HAPLO_contamination_check_merged_table.csv",
                "HAPLO_REMOVED_SEQUENCES": "{dataset_id}.{assembly_version}_HAPLO/autofilter/assembly_filtering_removed_sequences.txt",
                "HAPLO_MT_CONTIGS": "{dataset_id}.{assembly_version}_HAPLO/organelle_contamination_recommendations/{dataset_id}.{assembly_version}_HAPLO-{dataset_id}.{assembly_version}_MITO.contamination_recommendation"
            },
            "treeval": {
                "HIRES_PRETEXT": "hic_files/{dataset_id}_{assembly_version}_hr.pretext",
                "NORMAL_PRETEXT": "hic_files/{dataset_id}_{assembly_version}_normal.pretext"
            },
            "curation": {
                "HAP1": "{dataset_id}.hap1.{assembly_version}.primary.curated.fa.gz",
                "HAP2": "{dataset_id}.hap2.{assembly_version}.primary.curated.fa.gz"
            }
        }
    },
    "oxford_nanopore.phased": {
        "long_read_platform": "oxford_nanopore",
        "requires_hic": true,
        "assembler": "hifiasm",
        "outputs": {
            "genomeassembly": {
                "PRIMARY": "{dataset_id}.{assembly_version}.oxford_nanopore.phased/scaffolding/asm_hap1_scaffolds_final.fa.gz",
                "HAPLO": "{dataset_id}.{assembly_version}.oxford_nanopore.phased/scaffolding/asm_hap2_scaffolds_final.fa.gz"
            },
            "ascc": {
                "PRIMARY": "{dataset_id}.{assembly_version}_PRIMARY/autofilter/{dataset_id}.{assembly_version}_PRIMARY_autofiltered.fasta",
                "HAPLO": "{dataset_id}.{assembly_version}_HAPLO/autofilter/{dataset_id}.{assembly_version}_HAPLO_autofiltered.fasta"
            },
            "curation": {
                "HAP1": "{dataset_id}.hap1.{assembly_version}.primary.curated.fa.gz",
                "HAP2": "{dataset_id}.hap2.{assembly_version}.primary.curated.fa.gz"
            }
        }
    },
    "oatk": {
        "long_read_platform": "pacbio_hifi",
        "requires_hic": false,
        "requires_hmm": true,
        "assembler": "oatk",
        "outputs": {
            "genomeassembly": {
                "MITO": "{dataset_id}.{assembly_version}.oatk/asm.k1000_c320.mito.ctg.fasta",
                "PLASTID": "{dataset_id}.{assembly_version}.oatk/asm.k1000_c320.pltd.ctg.fasta"
            }
        }
    },
    "mitohifi": {
        "long_read_platform": "pacbio_hifi",
        "requires_hic": false,
        "requires_mitohifi_reference_species": true,
        "assembler": "mitohifi",
        "outputs": {
            "genomeassembly": {
                "MITO": "{dataset_id}.{assembly_version}.mitohifi/FIXME.fa",
                "PLASTID": "{dataset_id}.{assembly_version}.mitohifi/FIXME.fa"
            }
        }
    }
}